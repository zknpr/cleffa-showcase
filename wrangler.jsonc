{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cleffa-showcase",
  "main": "worker.ts",
  // No account_id: set CLOUDFLARE_ACCOUNT_ID when deploying, so the repository names no account.
  "compatibility_date": "2026-10-08",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "cleffa.zknpr.xyz", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // The relay carries visitor credentials. No invocation logs, traces, or application logging.
  "observability": { "enabled": false },
  "ratelimits": [{ "name": "RELAY_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }]
}
