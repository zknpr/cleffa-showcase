{
  "name": "cleffa-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Example client for the cleffa engine: webcam, video, screenshot triage and image interrogation over SystemOne requests",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "start": "bun run server.ts",
    "smoke": "bun run smoke.ts",
    "test": "bun test tests/*.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "types": "wrangler types --include-runtime false",
    "dev:public": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:smart-resize": "bun run tests/smart_resize_check.ts"
  },
  "cleffa": {
    "repository": "https://github.com/zknpr/cleffa",
    "commit": "24fc91e"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "wrangler": "4.148.0"
  }
}
